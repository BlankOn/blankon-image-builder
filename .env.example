# Copy this file to .env. Keep .env secret and untracked.
# Telegram bot token used for build notifications.
TELEGRAM_BOT_KEY="your-telegram-bot-key-here"

# Absolute host path for the build lock; keep it under BUILD_LOCAL.
BUILD_LOCKFILE="/home/user/blankon/.blankon-build.lock"
# Base URL for published artifacts and zsync metadata.
BUILD_PUBLISH_URL="http://arsip-dev.blankonlinux.id/iso"
# Absolute, writable host directory for remote build output.
BUILD_JAHITAN_PATH="/home/user/iso/jahitan"

# Absolute host root for local source checkouts; must be writable/mounted.
# Keep blankon-live-builder and blankon-live-build below this directory.
BUILD_LOCAL="/home/user/blankon"
