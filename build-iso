#!/usr/bin/env bash
set -o pipefail

PROJECT_ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
RUNTIME_PATH="$PROJECT_ROOT/libexec/blankon-image-builder/build-iso-runtime"
export BLANKON_IMAGE_BUILDER_ROOT="$PROJECT_ROOT"
export BLANKON_IMAGE_BUILDER_COMMAND="$PROJECT_ROOT/build-iso"

if [[ "${BASH_SOURCE[0]}" != "$0" ]]; then
  source "$RUNTIME_PATH"
else
  exec "$RUNTIME_PATH" "$@"
fi
