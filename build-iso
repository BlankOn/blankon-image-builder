#!/usr/bin/env bash
set -o pipefail

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)

validate_required_environment() {
  MISSING_VARS=""
  [[ "${BUILD_SEND_TELEGRAM:-1}" == 0 || -n "${TELEGRAM_BOT_KEY:-}${TELEGRAM_BOT_KEY_FILE:-}" ]] || MISSING_VARS="$MISSING_VARS TELEGRAM_BOT_KEY"
  [[ -z "$BUILD_LOCKFILE" ]] && MISSING_VARS="$MISSING_VARS BUILD_LOCKFILE"
  [[ -z "$BUILD_JAHITAN_PATH" ]] && MISSING_VARS="$MISSING_VARS BUILD_JAHITAN_PATH"
  [[ -z "$BUILD_PUBLISH_URL" ]] && MISSING_VARS="$MISSING_VARS BUILD_PUBLISH_URL"
  [[ -z "$BUILD_LOCAL" ]] && MISSING_VARS="$MISSING_VARS BUILD_LOCAL"
  if [[ -n "$MISSING_VARS" ]]; then
    echo "Error: The following environment variables are missing:$MISSING_VARS"
    echo "Please check your .env file."
    return 1
  fi
}

prepare_build_tree() {
  local source_dir="$1"
  local variant

  variant=$(<"$source_dir/variant")
  if [[ ! "$variant" =~ ^[a-z0-9][a-z0-9-]*$ ]]; then
    echo "Error: Invalid variant: $variant"
    return 1
  fi
  if [[ ! -d "$source_dir/config/common" ]] || [[ ! -d "$source_dir/config/$variant" ]]; then
    echo "Error: Missing config/common or config/$variant"
    return 1
  fi

  rm -rf .build
  mkdir -p .build/config
  cp -a "$source_dir/config/common/." .build/config/
  cp -a "$source_dir/config/$variant/." .build/config/
  cp -a "$source_dir/auto" .build/auto
  cp "$source_dir/variant" .build/variant
  VARIANT="$variant"
  IMAGE_NAME="blankon-live-image-$VARIANT-$ARCH"
}

send_telegram() {
  send_host_telegram "$1"
}

cleanup() {
    local exit_status=$?

    [[ -n "$BUILDER_CONTAINER" ]] || return "$exit_status"
    [[ -n "${START:-}" ]] || return "$exit_status"
    save_package_cache || {
        echo "Error: Failed to save package cache" >&2
        (( exit_status != 0 )) || exit_status=1
    }
    finalize_build
    if [[ "${BUILD_SEND_TELEGRAM:-1}" != 0 && -n "$BRANCH" && -n "$TODAY" ]]; then
        if [[ -n "$COMMIT_URL" ]]; then
            send_telegram "💿 Jahitan harian $TODAY-$TODAY_COUNT [[ revisi <a href=\\\"$COMMIT_URL\\\">$COMMIT</a> ]] dari $REPO_NAME cabang $BRANCH $RESULT. $FAILURE_REASON $ACTION di ${BUILD_PUBLISH_URL}/$TODAY-$TODAY_COUNT/"
        else
            send_telegram "💿 Jahitan harian $TODAY-$TODAY_COUNT dari $REPO_NAME cabang $BRANCH $RESULT. $FAILURE_REASON $ACTION di ${BUILD_PUBLISH_URL}/$TODAY-$TODAY_COUNT/"
        fi
    fi
    return "$exit_status"
}

package_cache_key() {
    local archive="$WORKSPACE_DIR/.build/config/includes.chroot/etc/blankon/archive.conf"
    [[ -f "$archive" && ! -L "$archive" ]] || return 1
    printf '%s\n' "$ARCH" "$(sha256sum -- "$archive")" | sha256sum | cut -d ' ' -f 1
}

acquire_package_cache_lock() {
    exec {PACKAGE_CACHE_LOCK_FD}>"$WORKSPACE_DIR/.package-cache.lock" || return 1
    flock -n "$PACKAGE_CACHE_LOCK_FD" || {
        echo "Error: Package cache is in use by another build or purge" >&2
        return 1
    }
}

has_mount_beneath() {
    local path="$1" mount mounts
    mounts=$(findmnt --raw --noheadings --output TARGET) || return 2
    while IFS= read -r mount; do
        printf -v mount '%b' "$mount"
        [[ "$mount" == "$path" || "$mount" == "$path/"* ]] && return 0
    done <<< "$mounts"
    return 1
}

copy_package_debs() {
    local source="$1" destination="$2"
    mkdir -p "$destination" || return 1
    (cd "$source" && find . -type f -name '*.deb' -exec cp --parents --target-directory="$destination" -- {} +)
}

safe_package_cache() {
    local root="$WORKSPACE_DIR/package-cache" path stage mount_status
    [[ ! -L "$root" && ( ! -e "$root" || -d "$root" ) ]] || return 1
    if [[ -e "$root" ]]; then
        [[ "$(realpath -- "$root")" == "$root" ]] || return 1
        for path in "$root"/*; do
            [[ -e "$path" ]] || continue
            [[ -d "$path" && ! -L "$path" ]] || return 1
            for stage in "$path"/*; do
                [[ -e "$stage" ]] || continue
                [[ ! -L "$stage" ]] || return 1
            done
        done
    fi
    if has_mount_beneath "$root"; then mount_status=0; else mount_status=$?; fi
    (( mount_status == 1 )) || return 1
    return 0
}

restore_package_cache() {
    local key="$1" stage mount_status
    safe_package_cache || {
        echo "Error: Unsafe package-cache path" >&2
        return 1
    }
    [[ ! -L "$WORKSPACE_DIR/.build/cache" ]] || return 1
    for stage in bootstrap chroot binary; do
        if [[ -d "$WORKSPACE_DIR/package-cache/$key/packages.$stage" && ! -L "$WORKSPACE_DIR/package-cache/$key/packages.$stage" ]]; then
            if has_mount_beneath "$WORKSPACE_DIR/package-cache/$key/packages.$stage"; then mount_status=0; else mount_status=$?; fi
            (( mount_status == 1 )) || return 1
            if has_mount_beneath "$WORKSPACE_DIR/.build/cache"; then mount_status=0; else mount_status=$?; fi
            (( mount_status == 1 )) || return 1
        fi
    done
    mkdir -p "$WORKSPACE_DIR/package-cache/$key"
    for stage in bootstrap chroot binary; do
        if [[ -d "$WORKSPACE_DIR/package-cache/$key/packages.$stage" && ! -L "$WORKSPACE_DIR/package-cache/$key/packages.$stage" ]]; then
            mkdir -p "$WORKSPACE_DIR/.build/cache"
            copy_package_debs "$WORKSPACE_DIR/package-cache/$key/packages.$stage" "$WORKSPACE_DIR/.build/cache/packages.$stage" || return 1
        fi
    done
}

save_package_cache() {
    local key stage mount_status
    [[ -d "$WORKSPACE_DIR/.build/config" && -d "$WORKSPACE_DIR/.build/auto" ]] || return 0
    key=$(package_cache_key) || return 1
    safe_package_cache || return 1
    [[ ! -L "$WORKSPACE_DIR/.build/cache" ]] || return 1
    if has_mount_beneath "$WORKSPACE_DIR/.build/cache"; then mount_status=0; else mount_status=$?; fi
    (( mount_status == 1 )) || return 1
    for stage in bootstrap chroot binary; do
        if [[ -d "$WORKSPACE_DIR/.build/cache/packages.$stage" && ! -L "$WORKSPACE_DIR/.build/cache/packages.$stage" ]]; then
            if has_mount_beneath "$WORKSPACE_DIR/.build/cache/packages.$stage"; then mount_status=0; else mount_status=$?; fi
            (( mount_status == 1 )) || return 1
        fi
    done
    mkdir -p "$WORKSPACE_DIR/package-cache/$key" || return 1
    for stage in bootstrap chroot binary; do
        if [[ -d "$WORKSPACE_DIR/.build/cache/packages.$stage" && ! -L "$WORKSPACE_DIR/.build/cache/packages.$stage" ]]; then
            copy_package_debs "$WORKSPACE_DIR/.build/cache/packages.$stage" "$WORKSPACE_DIR/package-cache/$key/packages.$stage" || return 1
        fi
    done
}

update_current_output() {
    local current="$BUILD_JAHITAN_PATH/current" staged backup had_previous=0 mount_status

    if has_mount_beneath "$current"; then mount_status=0; else mount_status=$?; fi
    (( mount_status == 1 )) || {
        echo "Error: Mount beneath current Jahitan output" >&2
        return 1
    }

    staged=$(mktemp -d "$BUILD_JAHITAN_PATH/.current.stage.XXXXXXXX") || return 1
    if ! cp -vR "$TARGET_DIR/." "$staged/" || \
       ! printf '%s\n' "$TODAY-$TODAY_COUNT" > "$staged/current.txt" || \
       ! chmod --reference="$TARGET_DIR" "$staged"; then
        rm -rf -- "$staged"
        return 1
    fi

    backup=$(mktemp -d "$BUILD_JAHITAN_PATH/.current.backup.XXXXXXXX") || {
        rm -rf -- "$staged"
        return 1
    }
    if [[ -e "$current" || -L "$current" ]]; then
        if ! mv -- "$current" "$backup/previous"; then
            rm -rf -- "$staged" "$backup"
            return 1
        fi
        had_previous=1
    fi
    if ! mv -- "$staged" "$current"; then
        if (( had_previous )) && ! mv -- "$backup/previous" "$current"; then
            echo "Error: Previous current output remains at $backup/previous" >&2
        else
            rm -rf -- "$backup"
        fi
        rm -rf -- "$staged"
        return 1
    fi

    CURRENT_OUTPUT_UPDATED=1
    if ! rm -rf -- "$backup"; then
        echo "Warning: Previous current output remains at $backup" >&2
    fi
}

publish_artifacts() {
    local suffix

    for suffix in contents files packages hybrid.iso; do
        if ! cp -v "$IMAGE_NAME.$suffix" "$TARGET_DIR/$IMAGE_NAME.$suffix"; then
            FAILURE_REASON="Error: Failed to publish $IMAGE_NAME.$suffix"
            RESULT="gagal terbit ❌"
            return 1
        fi
    done
    if ! zsyncmake -u "${BUILD_PUBLISH_URL}/current/$IMAGE_NAME.hybrid.iso" \
        -o "$TARGET_DIR/$IMAGE_NAME.hybrid.iso.zsync" "$TARGET_DIR/$IMAGE_NAME.hybrid.iso"; then
        FAILURE_REASON="Error: Failed to generate zsync metadata"
        RESULT="gagal terbit ❌"
        return 1
    fi
    if ! sha256sum "$TARGET_DIR/$IMAGE_NAME.hybrid.iso" | sed 's#  .*/#  #' > "$TARGET_DIR/$IMAGE_NAME.hybrid.iso.sha256sum"; then
        FAILURE_REASON="Error: Failed to generate SHA-256 checksum"
        RESULT="gagal terbit ❌"
        return 1
    fi
    if ! update_current_output; then
        FAILURE_REASON="Error: Failed to update current Jahitan artifacts"
        RESULT="gagal terbit ❌"
        return 1
    fi
}

finalize_build() {
    local end duration total_duration

    end=$(date +%s)
    duration=$((end - START))
    total_duration="Done in $(date -d@$duration -u +%H:%M:%S)."
    echo "$total_duration"
    if [[ -n "$IMAGE_NAME" && -f "$IMAGE_NAME.build.log" ]]; then
        [[ -z "$FAILURE_REASON" ]] || printf '%s\n' "$FAILURE_REASON" >> "$IMAGE_NAME.build.log"
        echo "$total_duration" >> "$IMAGE_NAME.build.log"
        if [[ -d "$TARGET_DIR" ]]; then
            tail -n 100 "$IMAGE_NAME.build.log" > "$TARGET_DIR/$IMAGE_NAME.tail100.build.log.txt"
            cp -v "$IMAGE_NAME.build.log" "$TARGET_DIR/$IMAGE_NAME.build.log.txt"
        fi
    fi

    unmount_build_workspace_mounts
}

usage() {
  echo "Usage: $0 --local <source-dir>"
  echo "       $0 --remote <repo> <branch> [commit]"
}

initialize_runtime_state() {
  trap cleanup EXIT
  RESULT="gagal terbit ❌"
  ACTION="Log build dapat disimak"
  FAILURE_REASON=""
  LOCAL_SOURCE=""
  REPO=""
  BRANCH=""
  COMMIT=""
  START=""
  LOCK_ACQUIRED=0
  CURRENT_OUTPUT_UPDATED=0
}

validate_host_root() {
  [[ "$BUILD_LOCAL" == /* ]] || {
    echo "Error: BUILD_LOCAL must be an absolute directory: $BUILD_LOCAL"
    exit 2
  }
  [[ -d "$BUILD_LOCAL" ]] || {
    echo "Error: BUILD_LOCAL directory not found: $BUILD_LOCAL"
    exit 2
  }
  if ! BUILD_LOCAL_ROOT=$(realpath -- "$BUILD_LOCAL"); then
    echo "Error: Cannot canonicalize BUILD_LOCAL: $BUILD_LOCAL"
    exit 2
  fi
  export BUILD_LOCAL="$BUILD_LOCAL_ROOT"
}

parse_local_source() {
  local source_candidate="$1"

  if [[ -z "$BUILDER_CONTAINER" ]]; then
    if [[ "$source_candidate" == /* ]]; then
      SOURCE_CANDIDATE=$source_candidate
    else
      SOURCE_CANDIDATE="$BUILD_LOCAL_ROOT/$source_candidate"
    fi
    [[ -d "$SOURCE_CANDIDATE" ]] || {
      echo "Error: Local source directory not found: $SOURCE_CANDIDATE"
      exit 2
    }
    if ! LOCAL_SOURCE=$(realpath -- "$SOURCE_CANDIDATE"); then
      echo "Error: Cannot canonicalize local source: $SOURCE_CANDIDATE"
      exit 2
    fi
    if [[ "$BUILD_LOCAL_ROOT" != "/" && "$LOCAL_SOURCE" != "$BUILD_LOCAL_ROOT" && "$LOCAL_SOURCE" != "$BUILD_LOCAL_ROOT/"* ]]; then
      echo "Error: Local source must stay under BUILD_LOCAL: $LOCAL_SOURCE"
      exit 2
    fi
  else
    [[ "$source_candidate" == /* ]] || { echo "Error: Local source path must be absolute: $source_candidate"; exit 2; }
    [[ -d "$source_candidate" ]] || { echo "Error: Local source directory not found: $source_candidate"; exit 2; }
    LOCAL_SOURCE=$source_candidate
  fi
}

parse_arguments() {
  [[ $# -gt 0 ]] || { usage; exit 2; }
  MODE=$1
  if [[ -z "$BUILDER_CONTAINER" ]]; then
    validate_host_root
  fi
  case "$MODE" in
    --local)
      [[ $# -eq 2 ]] || { usage; exit 2; }
      parse_local_source "$2"
      ;;
    --remote)
      [[ $# -ge 3 && $# -le 4 ]] || { usage; exit 2; }
      REPO=$2
      BRANCH=$3
      COMMIT=${4:-}
      ;;
    *)
      usage
      exit 2
      ;;
  esac
}

dispatch_build() {
  run_container_build
}

run_host_podman_build() {
  local env_file="$SCRIPT_DIR/.env" line name value source_path package_lock host_build_lock canonical_workdir canonical_output notification_message
  if [[ "$#" -lt 2 || ( "$1" != --local && "$1" != --remote ) || ( "$1" == --local && "$#" -ne 2 ) || ( "$1" == --remote && ( "$#" -lt 3 || "$#" -gt 4 ) ) ]]; then
    usage >&2
    return 2
  fi
  [[ -f "$env_file" ]] || { echo "Error: Environment file not found: $env_file" >&2; return 1; }
  BUILD_LOCAL= BUILD_LOCKFILE= BUILD_JAHITAN_PATH= BUILD_PUBLISH_URL= TELEGRAM_BOT_KEY= BUILD_SEND_TELEGRAM=1
  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ "$line" =~ ^[[:space:]]*(BUILD_LOCAL|BUILD_LOCKFILE|BUILD_JAHITAN_PATH|BUILD_PUBLISH_URL|TELEGRAM_BOT_KEY|BUILD_SEND_TELEGRAM)=(.*)$ ]] || continue
    name=${BASH_REMATCH[1]}; value=${BASH_REMATCH[2]}
    local seen_name="${name}_SEEN"
    [[ "${!seen_name:-}" != 1 ]] || { echo "Error: Duplicate $name assignment in .env." >&2; return 1; }
    printf -v "$seen_name" '%s' 1
    if [[ "$value" == \"* ]]; then [[ "$value" == *\" ]] || return 1; value=${value:1:${#value}-2};
    elif [[ "$value" == \'* ]]; then [[ "$value" == *\' ]] || return 1; value=${value:1:${#value}-2}; fi
    if [[ "$name" == BUILD_PUBLISH_URL ]]; then
      [[ "$value" =~ ^https?://[A-Za-z0-9._:/-]+$ ]] || { echo 'Error: Unsupported BUILD_PUBLISH_URL syntax in .env.' >&2; return 1; }
    elif [[ "$name" == TELEGRAM_BOT_KEY ]]; then
      [[ "$value" =~ ^[A-Za-z0-9:_-]*$ ]] || { echo 'Error: Unsupported TELEGRAM_BOT_KEY syntax in .env.' >&2; return 1; }
    elif [[ "$name" == BUILD_SEND_TELEGRAM ]]; then
      [[ "$value" == 0 || "$value" == 1 ]] || { echo 'Error: BUILD_SEND_TELEGRAM must be 0 or 1.' >&2; return 1; }
    else
      [[ "$value" =~ ^/[A-Za-z0-9_./[:space:]-]+$ ]] || { echo "Error: Unsupported syntax in $name assignment in .env." >&2; return 1; }
    fi
    printf -v "$name" '%s' "$value"
  done < "$env_file"
  export -n TELEGRAM_BOT_KEY TELEGRAM_BOT_KEY_FILE 2>/dev/null || true
  [[ "$BUILD_SEND_TELEGRAM" == 0 || -n "$TELEGRAM_BOT_KEY" ]] || { echo 'Error: TELEGRAM_BOT_KEY is required when notifications are enabled.' >&2; return 1; }
  [[ "$BUILD_LOCAL" == /* && -d "$BUILD_LOCAL" && "$BUILD_LOCKFILE" == /* && "$BUILD_JAHITAN_PATH" == /* && "$BUILD_PUBLISH_URL" =~ ^https?://[A-Za-z0-9._:/-]+$ ]] || { echo 'Error: Invalid build configuration.' >&2; return 1; }
  SCRIPT_DIR=$(realpath -- "$SCRIPT_DIR") || return 1
  BUILD_LOCAL=$(realpath -- "$BUILD_LOCAL") || return 1
  [[ "$BUILD_LOCAL" != / ]] || { echo 'Error: BUILD_LOCAL cannot be the filesystem root.' >&2; return 1; }
  command -v podman >/dev/null 2>&1 || { echo 'Error: Podman is required.' >&2; return 1; }
  [[ "$(env -u TELEGRAM_BOT_KEY -u TELEGRAM_BOT_KEY_FILE podman info --format '{{.Host.Security.Rootless}}')" == true ]] || { echo 'Error: A rootless Podman engine is required.' >&2; return 1; }
  source_path=
  [[ "$1" != --local ]] || { source_path=$2; [[ "$source_path" == /* ]] || source_path="$BUILD_LOCAL/$source_path"; }
  [[ ! -L "$SCRIPT_DIR/workdir" ]] || { echo 'Error: workdir cannot be a symlink.' >&2; return 1; }
  canonical_workdir=$(realpath -m -- "$SCRIPT_DIR/workdir") || return 1
  canonical_output=$(realpath -m -- "$BUILD_JAHITAN_PATH") || return 1
  [[ "$canonical_output" != / ]] || { echo 'Error: Output cannot be the filesystem root.' >&2; return 1; }
  BUILD_JAHITAN_PATH=$canonical_output
  paths_overlap() {
    [[ "$1" == "$2" || "$1" == "$2/"* || "$2" == "$1/"* || "$1" == / || "$2" == / ]]
  }
  [[ "$BUILD_JAHITAN_PATH" != "$BUILD_LOCAL" && "$BUILD_LOCAL" != "$BUILD_JAHITAN_PATH/"* ]] || { echo 'Error: Output cannot equal or contain BUILD_LOCAL.' >&2; return 1; }
  if [[ "$1" == --local ]]; then
    source_path=$2; [[ "$source_path" == /* ]] || source_path="$BUILD_LOCAL/$source_path"
    [[ -d "$source_path" ]] || { echo 'Error: Local source directory not found.' >&2; return 1; }
    source_path=$(realpath -- "$source_path")
    [[ "$source_path" == "$BUILD_LOCAL" || "$source_path" == "$BUILD_LOCAL/"* ]] || { echo 'Error: Local source must stay under BUILD_LOCAL.' >&2; return 1; }
    if paths_overlap "$source_path" "$SCRIPT_DIR"; then echo 'Error: Local source overlaps builder checkout.' >&2; return 1; fi
    if paths_overlap "$BUILD_JAHITAN_PATH" "$source_path"; then echo 'Error: Output and source paths overlap.' >&2; return 1; fi
  fi
  if paths_overlap "$BUILD_JAHITAN_PATH" "$SCRIPT_DIR" || paths_overlap "$BUILD_JAHITAN_PATH" "$canonical_workdir"; then echo 'Error: Output overlaps builder checkout or workdir.' >&2; return 1; fi
   [[ ! -L "$BUILD_LOCKFILE" ]] || { echo 'Error: Build lockfile cannot be a symlink.' >&2; return 1; }
  host_build_lock=$(dirname -- "$BUILD_LOCKFILE"); [[ -d "$host_build_lock" ]] || { echo 'Error: Build lock parent must exist.' >&2; return 1; }
  host_build_lock=$(realpath -- "$host_build_lock"); BUILD_LOCKFILE="$host_build_lock/$(basename -- "$BUILD_LOCKFILE")"
  [[ -w "$host_build_lock" && ( ! -e "$BUILD_LOCKFILE" || ( -f "$BUILD_LOCKFILE" && -w "$BUILD_LOCKFILE" ) ) ]] || { echo 'Error: Build lock path is not writable or is not a regular file.' >&2; return 1; }
   for protected_path in "$SCRIPT_DIR" "$canonical_workdir" "$BUILD_JAHITAN_PATH" "$source_path"; do
    [[ -n "$protected_path" ]] || continue
    if paths_overlap "$BUILD_LOCKFILE" "$protected_path"; then echo 'Error: Build lockfile overlaps a protected path.' >&2; return 1; fi
  done
  [[ ! -e "$canonical_workdir" || ( -d "$canonical_workdir" && -w "$canonical_workdir" ) ]] || { echo 'Error: workdir is not writable or is not a directory.' >&2; return 1; }
  [[ ! -e "$BUILD_JAHITAN_PATH" || ( -d "$BUILD_JAHITAN_PATH" && -w "$BUILD_JAHITAN_PATH" ) ]] || { echo 'Error: Output is not writable or is not a directory.' >&2; return 1; }
  exec {BUILD_LOCK_FD}>>"$BUILD_LOCKFILE" || { echo 'Error: Cannot open build lockfile.' >&2; return 1; }
  flock -n "$BUILD_LOCK_FD" || { echo 'Error: Build is already in progress.' >&2; return 1; }
  package_lock="$canonical_workdir/.package-cache.lock"
  [[ ! -L "$package_lock" && ( ! -e "$package_lock" || -f "$package_lock" ) ]] || { echo 'Error: Package-cache lock must be a regular non-symlink file.' >&2; return 1; }
  mkdir -p -- "$canonical_workdir" || return 1
  [[ ! -L "$package_lock" && ( ! -e "$package_lock" || -f "$package_lock" ) ]] || { echo 'Error: Package-cache lock must be a regular non-symlink file.' >&2; return 1; }
  if [[ ! -e "$package_lock" ]]; then ( set -o noclobber; : > "$package_lock" ) 2>/dev/null || return 1; fi
  exec {PACKAGE_LOCK_FD}>>"$package_lock" || { echo 'Error: Cannot open package-cache lock.' >&2; return 1; }
  flock -n "$PACKAGE_LOCK_FD" || { echo 'Error: Package cache is in use by another build or purge.' >&2; return 1; }
  mkdir -p -- "$BUILD_JAHITAN_PATH" || return 1
  env -u TELEGRAM_BOT_KEY -u TELEGRAM_BOT_KEY_FILE podman build --tag blankon-image-builder:podman --file "$SCRIPT_DIR/Dockerfile" "$SCRIPT_DIR" || return 1
  local container_build_local=/workdir
  [[ -z "$source_path" ]] || container_build_local=$source_path
  local -a args=(run --rm --userns=host --user 0:0 --cap-add=SYS_ADMIN --security-opt 'unmask=/proc/*' --workdir /workdir --volume "$SCRIPT_DIR/workdir:/workdir:rw" --volume "$package_lock:/workdir/.package-cache.lock:ro" --volume "$BUILD_JAHITAN_PATH:$BUILD_JAHITAN_PATH:rw" --env BUILDER_CONTAINER=1 --env PODMAN_MODE=1 --env BUILD_SEND_TELEGRAM=0 --env "BUILD_LOCAL=$container_build_local" --env "BUILD_JAHITAN_PATH=$BUILD_JAHITAN_PATH" --env "BUILD_PUBLISH_URL=$BUILD_PUBLISH_URL" --env BUILD_LOCK_HELD=1 --env PACKAGE_CACHE_LOCK_HELD=1)
  if [[ -n "$source_path" ]]; then args+=(--volume "$source_path:$source_path:ro"); fi
  args+=(blankon-image-builder:podman /usr/local/bin/build-iso --namespace-build "$1")
  if [[ "$1" == --local ]]; then args+=("$source_path"); else args+=("${@:2}"); fi
  local build_status=0
  env -u TELEGRAM_BOT_KEY -u TELEGRAM_BOT_KEY_FILE podman "${args[@]}" || build_status=$?
  if [[ "$BUILD_SEND_TELEGRAM" != 0 ]]; then
    local notification_message notification_status=0
    if [[ "$1" == --local ]]; then notification_message="Local build ${source_path} at ${BUILD_PUBLISH_URL} status $([[ $build_status == 0 ]] && printf success || printf failure)"; else notification_message="Remote build $2 branch $3 commit ${4:-unspecified} at ${BUILD_PUBLISH_URL} status $([[ $build_status == 0 ]] && printf success || printf failure)"; fi
    send_host_telegram "$notification_message" || notification_status=$?
    (( notification_status == 0 )) || { echo 'Error: Build notification failed.' >&2; (( build_status != 0 )) || build_status=1; }
  fi
  return "$build_status"
}

send_host_telegram() {
  local message="$1" token
  token=$TELEGRAM_BOT_KEY
  [[ -n "$token" ]] || return 1
  printf '%s\n%s' "$token" "$message" | python3 -c 'import html,json,sys; token=sys.stdin.readline().rstrip("\n"); message=html.escape(sys.stdin.read(), quote=True); payload={"chat_id":"-1001067745576","message_thread_id":51909,"parse_mode":"HTML","disable_web_page_preview":True,"text":message,"disable_notification":True}; print("url = "+json.dumps("https://api.telegram.org/bot"+token+"/sendMessage")); print("request = \"POST\""); print("header = \"Content-Type: application/json\""); print("data = "+json.dumps(json.dumps(payload)))' | env -u TELEGRAM_BOT_KEY -u TELEGRAM_BOT_KEY_FILE curl --silent --fail --output /dev/null --config - 2>/dev/null
}

acquire_build_lock() {
  [[ "$BUILD_LOCKFILE" == /* ]] || { echo "Error: BUILD_LOCKFILE must be an absolute path: $BUILD_LOCKFILE" >&2; exit 1; }
  [[ ! -L "$BUILD_LOCKFILE" ]] || { echo "Error: Build lockfile cannot be a symlink: $BUILD_LOCKFILE" >&2; exit 1; }
  exec {BUILD_LOCK_FD}>>"$BUILD_LOCKFILE" || { echo "Error: Cannot open build lockfile: $BUILD_LOCKFILE" >&2; exit 1; }
  flock -n "$BUILD_LOCK_FD" || { echo "Error: Build is already in progress" >&2; exit 1; }
  LOCK_ACQUIRED=1
}

prepare_output_directory() {
  if [[ "$BUILD_JAHITAN_PATH" != /* ]]; then
    FAILURE_REASON="Error: BUILD_JAHITAN_PATH must be an absolute path: $BUILD_JAHITAN_PATH"
    exit 1
  fi
  if ! mkdir -p "$BUILD_JAHITAN_PATH"; then
    FAILURE_REASON="Error: Cannot create BUILD_JAHITAN_PATH: $BUILD_JAHITAN_PATH"
    exit 1
  fi

  TODAY=$(date '+%Y%m%d')
  TODAY_COUNT=$(find "$BUILD_JAHITAN_PATH" -mindepth 1 -maxdepth 1 -type d -name "$TODAY-*" | wc -l)
  TODAY_COUNT=$((TODAY_COUNT + 1))
  TARGET_DIR="$BUILD_JAHITAN_PATH/$TODAY-$TODAY_COUNT"
  if ! mkdir -p "$TARGET_DIR"; then
    FAILURE_REASON="Error: Cannot create build output directory: $TARGET_DIR"
    exit 1
  fi
}

set_repository_name() {
  if [[ "$MODE" == "--local" ]]; then
    REPO_NAME="local:$LOCAL_SOURCE"
    BRANCH="local"
  else
    REPO_NAME=$(echo "$REPO" | sed -E 's|.*github.com[:/]([^/]+/[^/.]+)(\.git)?|\1|')
  fi
}

clean_build_workspace() {
  ARCH=amd64
  unmount_build_workspace_mounts
  rm -rf ./chroot ./local ./cache ./tmp || true
}

unmount_build_workspace_mounts() {
  local mount_target
  while IFS= read -r mount_target; do
    umount "$mount_target" || true
  done < <(mount | awk -v prefix="$WORKSPACE_DIR/.build/" 'substr($3, 1, length(prefix)) == prefix { print length($3), $3 }' | sort -rn | cut -d ' ' -f 2-)
}

build_local_image() {
  prepare_build_tree "$LOCAL_SOURCE" || exit 1
  local cache_key
  cd .build || exit 1
  lb clean || exit 1
  cd .. || exit 1
  cache_key=$(package_cache_key) || exit 1
  restore_package_cache "$cache_key" || exit 1
  cd .build || exit 1
  lb config --architectures "$ARCH" || exit 1
  if ! lb build --debug | tee -a "$IMAGE_NAME.build.log"; then
    FAILURE_REASON="Error: Local live-build failed"
    exit 1
  fi
}

prepare_remote_source() {
  echo "Processing $REPO $BRANCH $COMMIT ..."
  mkdir -p tmp || true
  chmod -R a+rw tmp

  if ! git clone -b "$BRANCH" "$REPO" "./tmp/$TODAY-$TODAY_COUNT" 2>&1; then
    FAILURE_REASON="Error: Failed to clone $REPO branch $BRANCH"
    exit 1
  fi
  if [[ ! -d "./tmp/$TODAY-$TODAY_COUNT/.git" ]]; then
    FAILURE_REASON="Error: Clone directory is missing or incomplete"
    exit 1
  fi
  if [[ -n "$COMMIT" ]] && ! git -C "./tmp/$TODAY-$TODAY_COUNT" checkout "$COMMIT"; then
    FAILURE_REASON="Error: Failed to checkout commit $COMMIT"
    exit 1
  fi

  COMMIT=$(git -C "./tmp/$TODAY-$TODAY_COUNT" rev-parse --short HEAD)
  CLEAN_REPO_URL=$(echo "$REPO" | sed 's/\.git$//')
  COMMIT_URL="$CLEAN_REPO_URL/commit/$COMMIT"
}

build_remote_image() {
  prepare_remote_source
  prepare_build_tree "./tmp/$TODAY-$TODAY_COUNT" || exit 1
  local cache_key
  cd .build || exit 1
  if [[ -f config/bootloaders/syslinux_common/splash.svg ]]; then
    sed -i 's/BUILD_NUMBER/'"$TODAY-$TODAY_COUNT"'/g' config/bootloaders/syslinux_common/splash.svg || exit 1
  fi
  cd .. || exit 1
  cache_key=$(package_cache_key) || exit 1
  cd .build || exit 1
  lb clean --purge || exit 1
  cd .. || exit 1
  restore_package_cache "$cache_key" || exit 1
  cd .build || exit 1
  lb config --architectures "$ARCH" || exit 1
  rm -f "$IMAGE_NAME.build.log"
  if ! lb build 2>&1 | tee "$IMAGE_NAME.build.log"; then
    FAILURE_REASON="Error: Remote live-build failed"
    exit 1
  fi
}

build_image() {
  if [[ "$MODE" == "--local" ]]; then
    build_local_image
  else
    build_remote_image
  fi

  if ! tail -n 10 "$IMAGE_NAME.build.log" | grep -q "P: Build completed successfully"; then
    FAILURE_REASON="Error: Build did not complete successfully"
    exit 1
  fi

  RESULT="telah terbit ✅"
  ACTION="Berkas citra dapat diunduh"
  publish_artifacts || exit 1
}

run_container_build() {
  WORKSPACE_DIR=$(pwd -P) || exit 1
  if [[ "${BUILD_LOCK_HELD:-}" != 1 ]]; then acquire_build_lock; fi
  if [[ "${PACKAGE_CACHE_LOCK_HELD:-}" != 1 ]]; then
    acquire_package_cache_lock || exit 1
  fi
  START=$(date +%s)
  prepare_output_directory
  set_repository_name
  clean_build_workspace
  build_image
}

run_namespace_build() {
  shift
  if [[ "${PODMAN_MODE:-}" == 1 ]]; then
    if ! unshare --mount --pid --fork --mount-proc --propagation private true; then
      echo "Error: Rootless Podman build namespace failed. Check that the outer rootless user namespace and runtime policy permit PID and mount namespaces." >&2
      return 1
    fi
    unshare --mount --pid --fork --mount-proc --propagation private "$SCRIPT_DIR/build-iso" --container-build "$@"
    return $?
  fi
  if ! unshare --user --map-users all --map-groups all --mount --pid --fork --mount-proc --propagation private true; then
    echo "Error: Rootless build namespace failed. Check that the host enables unprivileged user namespaces and that the selected container runtime policy permits the requested user, PID, and mount namespaces." >&2
    return 1
  fi
  unshare --user --map-users all --map-groups all --mount --pid --fork --mount-proc --propagation private "$SCRIPT_DIR/build-iso" --container-build "$@"
}

main() {
  if [[ "${1:-}" == --namespace-build ]]; then
    shift
    run_namespace_build --namespace-build "$@"
    return $?
  fi
  if [[ "${1:-}" == --container-build ]]; then
    shift
    BUILDER_CONTAINER=1
    initialize_runtime_state
    parse_arguments "$@"
    run_container_build
    return $?
  fi
  validate_required_environment || exit 1
  initialize_runtime_state
  parse_arguments "$@"
  dispatch_build "$@"
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  if [[ "${BUILDER_CONTAINER:-}" != 1 ]]; then
    run_host_podman_build "$@"
    exit $?
  fi
  main "$@"
  exit $?
fi
