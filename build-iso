#!/usr/bin/env bash
set -o pipefail

# Load configuration from the repository directory, not the caller's directory.
SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)

if [[ -f "$SCRIPT_DIR/.env" ]]; then
  source "$SCRIPT_DIR/.env"
fi

# Make sure envar is set
MISSING_VARS=""
[[ -z "$TELEGRAM_BOT_KEY" ]] && MISSING_VARS="$MISSING_VARS TELEGRAM_BOT_KEY"
[[ -z "$BUILD_LOCKFILE" ]] && MISSING_VARS="$MISSING_VARS BUILD_LOCKFILE"
[[ -z "$BUILD_JAHITAN_PATH" ]] && MISSING_VARS="$MISSING_VARS BUILD_JAHITAN_PATH"
[[ -z "$BUILD_PUBLISH_URL" ]] && MISSING_VARS="$MISSING_VARS BUILD_PUBLISH_URL"
[[ -z "$BUILD_LOCAL" ]] && MISSING_VARS="$MISSING_VARS BUILD_LOCAL"
if [[ -n "$MISSING_VARS" ]]; then
  echo "Error: The following environment variables are missing:$MISSING_VARS"
  echo "Please check your .env file."
  exit 1
fi

# Which archive the ISO is built from, and the archive the installed system
# is pointed at, both come from this file; see the comments in it.
ARCHIVE_CONF="config/includes.chroot/etc/blankon/archive.conf"

# "lb config" regenerates config/bootstrap, discarding any mirror values kept
# there, so they are reapplied from ARCHIVE_CONF after every call.
#
# The daily build replaces config/ wholesale with the branch it just cloned,
# so ARCHIVE_CONF is re-read on each call rather than once at startup: the
# archive that branch asks for is the one that has to win.
apply_archive_config() {
  local conf="config/bootstrap"

  if [[ ! -r "$ARCHIVE_CONF" ]]; then
    echo "Error: $ARCHIVE_CONF is missing. Cannot determine which archive to build from."
    return 1
  fi

  source "$ARCHIVE_CONF"

  if [[ -z "$ARCHIVE_URI" ]]; then
    echo "Error: $ARCHIVE_CONF did not define ARCHIVE_URI."
    return 1
  fi

  if [[ ! -f "$conf" ]]; then
    echo "Error: $conf is missing; cannot apply the archive configuration."
    return 1
  fi

  # config/ is root-owned once the daily build copies it into place, so the
  # rewrite goes through sudo regardless of who is running the build.
  sudo sed -i -E \
    "s#^(LB_(PARENT_)?MIRROR_[A-Z_]+=)\".*\"#\\1\"${ARCHIVE_URI}\"#" \
    "$conf"

  local applied
  applied=$(grep -cE "^LB_(PARENT_)?MIRROR_[A-Z_]+=\"${ARCHIVE_URI}\"" "$conf")

  if [[ "$applied" -eq 0 ]]; then
    echo "Error: no mirror entries in $conf were set to $ARCHIVE_URI."
    return 1
  fi

  echo "Pointed $applied mirror entries in $conf at $ARCHIVE_URI"
}

prepare_build_tree() {
  local source_dir="$1"
  local variant

  variant=$(<"$source_dir/variant")
  if [[ ! "$variant" =~ ^[a-z0-9][a-z0-9-]*$ ]]; then
    echo "Error: Invalid variant: $variant"
    return 1
  fi
  if [[ ! -d "$source_dir/config/common" ]] || [[ ! -d "$source_dir/config/$variant" ]]; then
    echo "Error: Missing config/common or config/$variant"
    return 1
  fi

  sudo rm -rf .build
  mkdir -p .build/config
  cp -a "$source_dir/config/common/." .build/config/
  cp -a "$source_dir/config/$variant/." .build/config/
  cp -a "$source_dir/auto" .build/auto
  cp "$source_dir/variant" .build/variant
  VARIANT="$variant"
  IMAGE_NAME="blankon-live-image-$VARIANT-$ARCH"
}

# Helper function
send_telegram() {
    local message="$1"
    curl -X POST -H 'Content-Type: application/json' \
        -d "{\"chat_id\": \"-1001067745576\", \"message_thread_id\": \"51909\", \"parse_mode\": \"HTML\", \"disable_web_page_preview\": true, \"text\": \"$message\", \"disable_notification\": true}" \
        https://api.telegram.org/bot"$TELEGRAM_BOT_KEY"/sendMessage
}

cleanup() {
    local exit_status=$?

    [[ -n "$BUILDER_CONTAINER" ]] || return "$exit_status"
    finalize_build
    if [[ "$LOCK_ACQUIRED" == 1 ]]; then
        rm -f "$BUILD_LOCKFILE"
    fi
    if [[ -n "$BRANCH" ]] && [[ -n "$TODAY" ]]; then
        if [[ -n "$COMMIT_URL" ]]; then
            # Clone succeeded, we have commit info
            send_telegram "💿 Jahitan harian $TODAY-$TODAY_COUNT [[ revisi <a href=\\\"$COMMIT_URL\\\">$COMMIT</a> ]] dari $REPO_NAME cabang $BRANCH $RESULT. $FAILURE_REASON $ACTION di ${BUILD_PUBLISH_URL}/$TODAY-$TODAY_COUNT/"
        else
            # Clone failed, no commit info available
            send_telegram "💿 Jahitan harian $TODAY-$TODAY_COUNT dari $REPO_NAME cabang $BRANCH $RESULT. $FAILURE_REASON $ACTION di ${BUILD_PUBLISH_URL}/$TODAY-$TODAY_COUNT/"
        fi
    fi
    return "$exit_status"
}

publish_artifacts() {
    local suffix

    for suffix in contents files packages hybrid.iso; do
        if ! cp -v "$IMAGE_NAME.$suffix" "$TARGET_DIR/$IMAGE_NAME.$suffix"; then
            FAILURE_REASON="Error: Failed to publish $IMAGE_NAME.$suffix"
            RESULT="gagal terbit ❌"
            return 1
        fi
    done
    if ! zsyncmake -u "${BUILD_PUBLISH_URL}/current/$IMAGE_NAME.hybrid.iso" \
        -o "$TARGET_DIR/$IMAGE_NAME.hybrid.iso.zsync" "$TARGET_DIR/$IMAGE_NAME.hybrid.iso"; then
        FAILURE_REASON="Error: Failed to generate zsync metadata"
        RESULT="gagal terbit ❌"
        return 1
    fi
    if ! sha256sum "$TARGET_DIR/$IMAGE_NAME.hybrid.iso" | sed 's#  .*/#  #' > "$TARGET_DIR/$IMAGE_NAME.hybrid.iso.sha256sum"; then
        FAILURE_REASON="Error: Failed to generate SHA-256 checksum"
        RESULT="gagal terbit ❌"
        return 1
    fi
    if ! sudo rm -rf "$BUILD_JAHITAN_PATH/current" || \
        ! sudo cp -vR "$TARGET_DIR" "$BUILD_JAHITAN_PATH/current" || \
        ! printf '%s\n' "$TODAY-$TODAY_COUNT" > "$BUILD_JAHITAN_PATH/current/current.txt"; then
        FAILURE_REASON="Error: Failed to update current Jahitan artifacts"
        RESULT="gagal terbit ❌"
        return 1
    fi
}

finalize_build() {
    local end duration total_duration

    end=$(date +%s)
    duration=$((end - START))
    total_duration="Done in $(date -d@$duration -u +%H:%M:%S)."
    echo "$total_duration"
    if [[ -n "$IMAGE_NAME" && -f "$IMAGE_NAME.build.log" ]]; then
        [[ -z "$FAILURE_REASON" ]] || printf '%s\n' "$FAILURE_REASON" >> "$IMAGE_NAME.build.log"
        echo "$total_duration" >> "$IMAGE_NAME.build.log"
        if [[ -d "$TARGET_DIR" ]]; then
            tail -n 100 "$IMAGE_NAME.build.log" > "$TARGET_DIR/$IMAGE_NAME.tail100.build.log.txt"
            cp -v "$IMAGE_NAME.build.log" "$TARGET_DIR/$IMAGE_NAME.build.log.txt"
        fi
    fi

    sudo umount "$(mount | grep live-build | cut -d ' ' -f 3)" || true
}

# Setup trap
trap cleanup EXIT

## Default messages
RESULT="gagal terbit ❌"
ACTION="Log build dapat disimak"
FAILURE_REASON=""

## Args
usage() {
  echo "Usage: $0 --local <source-dir>"
  echo "       $0 --remote <repo> <branch> [commit]"
}

validate_host_root() {
  [[ "$BUILD_LOCAL" == /* ]] || {
    echo "Error: BUILD_LOCAL must be an absolute directory: $BUILD_LOCAL"
    exit 2
  }
  [[ -d "$BUILD_LOCAL" ]] || {
    echo "Error: BUILD_LOCAL directory not found: $BUILD_LOCAL"
    exit 2
  }
  if ! BUILD_LOCAL_ROOT=$(realpath -- "$BUILD_LOCAL"); then
    echo "Error: Cannot canonicalize BUILD_LOCAL: $BUILD_LOCAL"
    exit 2
  fi
  export BUILD_LOCAL="$BUILD_LOCAL_ROOT"
}

run_in_container() {
  [[ -f "$SCRIPT_DIR/.env" ]] || {
    echo "Error: Environment file not found: $SCRIPT_DIR/.env"
    exit 1
  }
  command -v docker >/dev/null 2>&1 || {
    echo "Error: Docker is required but was not found in PATH."
    exit 1
  }
  docker compose version >/dev/null 2>&1 || {
    echo "Error: Docker Compose is required but is unavailable."
    exit 1
  }

  BUILD_LOCAL="$BUILD_LOCAL_ROOT" docker compose \
    --project-directory "$SCRIPT_DIR" \
    --env-file "$SCRIPT_DIR/.env" \
    run --build --rm builder /builder/build-iso "$@"
}

MODE=$1
LOCAL_SOURCE=""
REPO=""
BRANCH=""
COMMIT=""
LOCK_ACQUIRED=0
if [[ -z "$BUILDER_CONTAINER" ]]; then
  validate_host_root
fi
case "$MODE" in
  --local)
    [[ $# -eq 2 ]] || { usage; exit 2; }
    if [[ -z "$BUILDER_CONTAINER" ]]; then
      if [[ "$2" == /* ]]; then
        SOURCE_CANDIDATE=$2
      else
        SOURCE_CANDIDATE="$BUILD_LOCAL_ROOT/$2"
      fi
      [[ -d "$SOURCE_CANDIDATE" ]] || {
        echo "Error: Local source directory not found: $SOURCE_CANDIDATE"
        exit 2
      }
      if ! LOCAL_SOURCE=$(realpath -- "$SOURCE_CANDIDATE"); then
        echo "Error: Cannot canonicalize local source: $SOURCE_CANDIDATE"
        exit 2
      fi
      if [[ "$BUILD_LOCAL_ROOT" != "/" && "$LOCAL_SOURCE" != "$BUILD_LOCAL_ROOT" && "$LOCAL_SOURCE" != "$BUILD_LOCAL_ROOT/"* ]]; then
        echo "Error: Local source must stay under BUILD_LOCAL: $LOCAL_SOURCE"
        exit 2
      fi
    else
      [[ "$2" == /* ]] || { echo "Error: Local source path must be absolute: $2"; exit 2; }
      [[ -d "$2" ]] || { echo "Error: Local source directory not found: $2"; exit 2; }
      LOCAL_SOURCE=$2
    fi
    ;;
  --remote)
    [[ $# -ge 3 && $# -le 4 ]] || { usage; exit 2; }
    REPO=$2
    BRANCH=$3
    COMMIT=${4:-}
    ;;
  *)
    usage
    exit 2
    ;;
esac
if [[ -z "$BUILDER_CONTAINER" ]]; then
  if [[ "$MODE" == "--local" ]]; then
    run_in_container --local "$LOCAL_SOURCE"
  else
    run_in_container "$@"
  fi
  exit $?
fi

if [[ -f "$BUILD_LOCKFILE" ]]; then
    OLD_PID=$(cat "$BUILD_LOCKFILE")
    if ps -p "$OLD_PID" > /dev/null 2>&1; then
        echo "Error: Build already in progress (PID: $OLD_PID). Exiting."
        exit 1
    else
        echo "Warning: Removing stale lock file from PID $OLD_PID"
        rm -f "$BUILD_LOCKFILE"
    fi
fi
echo $$ > "$BUILD_LOCKFILE"
LOCK_ACQUIRED=1
START=$(date +%s)

if [[ "$BUILD_JAHITAN_PATH" != /* ]]; then
    FAILURE_REASON="Error: BUILD_JAHITAN_PATH must be an absolute path: $BUILD_JAHITAN_PATH"
    exit 1
fi
if ! mkdir -p "$BUILD_JAHITAN_PATH"; then
    FAILURE_REASON="Error: Cannot create BUILD_JAHITAN_PATH: $BUILD_JAHITAN_PATH"
    exit 1
fi

TODAY=$(date '+%Y%m%d')
TODAY_COUNT=$(find "$BUILD_JAHITAN_PATH" -mindepth 1 -maxdepth 1 -type d -name "$TODAY-*" | wc -l)
TODAY_COUNT=$((TODAY_COUNT + 1))
TARGET_DIR="$BUILD_JAHITAN_PATH/$TODAY-$TODAY_COUNT"
if ! mkdir -p "$TARGET_DIR"; then
    FAILURE_REASON="Error: Cannot create build output directory: $TARGET_DIR"
    exit 1
fi

if [[ "$MODE" == "--local" ]]; then
    REPO_NAME="local:$LOCAL_SOURCE"
    BRANCH="local"
else
    REPO_NAME=$(echo "$REPO" | sed -E 's|.*github.com[:/]([^/]+/[^/.]+)(\.git)?|\1|')
fi

# Optional
ARCH=amd64

sudo umount "$(mount | grep live-build | cut -d ' ' -f 3)" || true

sudo rm -rf ./chroot ./local ./cache ./tmp || true

if [[ "$MODE" == "--local" ]]; then
  prepare_build_tree "$LOCAL_SOURCE" || exit 1
  cd .build || exit 1
  sudo lb clean || exit 1
  sudo lb config --architectures "$ARCH" || exit 1
  apply_archive_config || exit 1
  if ! sudo lb build --debug | sudo tee -a "$IMAGE_NAME.build.log"; then
    FAILURE_REASON="Error: Local live-build failed"
    exit 1
  fi
else
  echo "Processing $REPO $BRANCH $COMMIT ..."
  sudo mkdir -p tmp || true
  sudo chmod -R a+rw tmp

  if ! git clone -b "$BRANCH" "$REPO" "./tmp/$TODAY-$TODAY_COUNT" 2>&1; then
      FAILURE_REASON="Error: Failed to clone $REPO branch $BRANCH"
      exit 1
  fi
  if [[ ! -d "./tmp/$TODAY-$TODAY_COUNT/.git" ]]; then
      FAILURE_REASON="Error: Clone directory is missing or incomplete"
      exit 1
  fi
  if [[ -n "$COMMIT" ]] && ! git -C "./tmp/$TODAY-$TODAY_COUNT" checkout "$COMMIT"; then
      FAILURE_REASON="Error: Failed to checkout commit $COMMIT"
      exit 1
  fi

  COMMIT=$(git -C "./tmp/$TODAY-$TODAY_COUNT" rev-parse --short HEAD)
  CLEAN_REPO_URL=$(echo "$REPO" | sed 's/\.git$//')
  COMMIT_URL="$CLEAN_REPO_URL/commit/$COMMIT"
  prepare_build_tree "./tmp/$TODAY-$TODAY_COUNT" || exit 1
  cd .build || exit 1
  sudo sed -i 's/BUILD_NUMBER/'"$TODAY-$TODAY_COUNT"'/g' config/bootloaders/syslinux_common/splash.svg
  sudo lb clean --purge || exit 1
  sudo lb config --architectures "$ARCH" || exit 1
  apply_archive_config || exit 1
  sudo rm -f "$IMAGE_NAME.build.log"
  if ! sudo lb build 2>&1 | tee "$IMAGE_NAME.build.log"; then
      FAILURE_REASON="Error: Remote live-build failed"
      exit 1
  fi
fi

if ! tail -n 10 "$IMAGE_NAME.build.log" | grep -q "P: Build completed successfully"; then
    FAILURE_REASON="Error: Build did not complete successfully"
    exit 1
fi

RESULT="telah terbit ✅"
ACTION="Berkas citra dapat diunduh"
publish_artifacts || exit 1
exit 0
