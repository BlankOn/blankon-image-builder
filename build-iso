#!/usr/bin/env bash
set -o pipefail

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)

validate_required_environment() {
  MISSING_VARS=""
  [[ -z "$TELEGRAM_BOT_KEY" ]] && MISSING_VARS="$MISSING_VARS TELEGRAM_BOT_KEY"
  [[ -z "$BUILD_LOCKFILE" ]] && MISSING_VARS="$MISSING_VARS BUILD_LOCKFILE"
  [[ -z "$BUILD_JAHITAN_PATH" ]] && MISSING_VARS="$MISSING_VARS BUILD_JAHITAN_PATH"
  [[ -z "$BUILD_PUBLISH_URL" ]] && MISSING_VARS="$MISSING_VARS BUILD_PUBLISH_URL"
  [[ -z "$BUILD_LOCAL" ]] && MISSING_VARS="$MISSING_VARS BUILD_LOCAL"
  if [[ -n "$MISSING_VARS" ]]; then
    echo "Error: The following environment variables are missing:$MISSING_VARS"
    echo "Please check your .env file."
    return 1
  fi
}

prepare_build_tree() {
  local source_dir="$1"
  local variant

  variant=$(<"$source_dir/variant")
  if [[ ! "$variant" =~ ^[a-z0-9][a-z0-9-]*$ ]]; then
    echo "Error: Invalid variant: $variant"
    return 1
  fi
  if [[ ! -d "$source_dir/config/common" ]] || [[ ! -d "$source_dir/config/$variant" ]]; then
    echo "Error: Missing config/common or config/$variant"
    return 1
  fi

  sudo rm -rf .build
  mkdir -p .build/config
  cp -a "$source_dir/config/common/." .build/config/
  cp -a "$source_dir/config/$variant/." .build/config/
  cp -a "$source_dir/auto" .build/auto
  cp "$source_dir/variant" .build/variant
  VARIANT="$variant"
  IMAGE_NAME="blankon-live-image-$VARIANT-$ARCH"
}

send_telegram() {
    local message="$1"
    curl -X POST -H 'Content-Type: application/json' \
        -d "{\"chat_id\": \"-1001067745576\", \"message_thread_id\": \"51909\", \"parse_mode\": \"HTML\", \"disable_web_page_preview\": true, \"text\": \"$message\", \"disable_notification\": true}" \
        https://api.telegram.org/bot"$TELEGRAM_BOT_KEY"/sendMessage
}

cleanup() {
    local exit_status=$?

    [[ -n "$BUILDER_CONTAINER" ]] || return "$exit_status"
    [[ -n "${START:-}" ]] || return "$exit_status"
    save_package_cache || {
        echo "Error: Failed to save package cache" >&2
        (( exit_status != 0 )) || exit_status=1
    }
    finalize_build
    handoff_output_ownership || {
        echo "Error: Failed to hand off output ownership" >&2
        (( exit_status != 0 )) || exit_status=1
    }
    if [[ "$LOCK_ACQUIRED" == 1 ]]; then
        rm -f "$BUILD_LOCKFILE"
    fi
    if [[ "${BUILD_SEND_TELEGRAM:-1}" != 0 && -n "$BRANCH" && -n "$TODAY" ]]; then
        if [[ -n "$COMMIT_URL" ]]; then
            send_telegram "💿 Jahitan harian $TODAY-$TODAY_COUNT [[ revisi <a href=\\\"$COMMIT_URL\\\">$COMMIT</a> ]] dari $REPO_NAME cabang $BRANCH $RESULT. $FAILURE_REASON $ACTION di ${BUILD_PUBLISH_URL}/$TODAY-$TODAY_COUNT/"
        else
            send_telegram "💿 Jahitan harian $TODAY-$TODAY_COUNT dari $REPO_NAME cabang $BRANCH $RESULT. $FAILURE_REASON $ACTION di ${BUILD_PUBLISH_URL}/$TODAY-$TODAY_COUNT/"
        fi
    fi
    return "$exit_status"
}

package_cache_key() {
    local archive="$WORKSPACE_DIR/.build/config/includes.chroot/etc/blankon/archive.conf"
    [[ -f "$archive" && ! -L "$archive" ]] || return 1
    printf '%s\n' "$ARCH" "$(sha256sum -- "$archive")" | sha256sum | cut -d ' ' -f 1
}

acquire_package_cache_lock() {
    exec {PACKAGE_CACHE_LOCK_FD}>"$WORKSPACE_DIR/.package-cache.lock" || return 1
    flock -n "$PACKAGE_CACHE_LOCK_FD" || {
        echo "Error: Package cache is in use by another build or purge" >&2
        return 1
    }
}

has_mount_beneath() {
    local path="$1" mount mounts
    mounts=$(findmnt --raw --noheadings --output TARGET) || return 2
    while IFS= read -r mount; do
        printf -v mount '%b' "$mount"
        [[ "$mount" == "$path" || "$mount" == "$path/"* ]] && return 0
    done <<< "$mounts"
    return 1
}

copy_package_debs() {
    local source="$1" destination="$2"
    mkdir -p "$destination" || return 1
    (cd "$source" && find . -type f -name '*.deb' -exec cp --parents --target-directory="$destination" -- {} +)
}

safe_package_cache() {
    local root="$WORKSPACE_DIR/package-cache" path stage mount_status
    [[ ! -L "$root" && ( ! -e "$root" || -d "$root" ) ]] || return 1
    if [[ -e "$root" ]]; then
        [[ "$(realpath -- "$root")" == "$root" ]] || return 1
        for path in "$root"/*; do
            [[ -e "$path" ]] || continue
            [[ -d "$path" && ! -L "$path" ]] || return 1
            for stage in "$path"/*; do
                [[ -e "$stage" ]] || continue
                [[ ! -L "$stage" ]] || return 1
            done
        done
    fi
    if has_mount_beneath "$root"; then mount_status=0; else mount_status=$?; fi
    (( mount_status == 1 )) || return 1
    return 0
}

restore_package_cache() {
    local key="$1" stage mount_status
    safe_package_cache || {
        echo "Error: Unsafe package-cache path" >&2
        return 1
    }
    [[ ! -L "$WORKSPACE_DIR/.build/cache" ]] || return 1
    for stage in bootstrap chroot binary; do
        if [[ -d "$WORKSPACE_DIR/package-cache/$key/packages.$stage" && ! -L "$WORKSPACE_DIR/package-cache/$key/packages.$stage" ]]; then
            if has_mount_beneath "$WORKSPACE_DIR/package-cache/$key/packages.$stage"; then mount_status=0; else mount_status=$?; fi
            (( mount_status == 1 )) || return 1
            if has_mount_beneath "$WORKSPACE_DIR/.build/cache"; then mount_status=0; else mount_status=$?; fi
            (( mount_status == 1 )) || return 1
        fi
    done
    mkdir -p "$WORKSPACE_DIR/package-cache/$key"
    for stage in bootstrap chroot binary; do
        if [[ -d "$WORKSPACE_DIR/package-cache/$key/packages.$stage" && ! -L "$WORKSPACE_DIR/package-cache/$key/packages.$stage" ]]; then
            mkdir -p "$WORKSPACE_DIR/.build/cache"
            copy_package_debs "$WORKSPACE_DIR/package-cache/$key/packages.$stage" "$WORKSPACE_DIR/.build/cache/packages.$stage" || return 1
        fi
    done
}

save_package_cache() {
    local key stage mount_status
    [[ -d "$WORKSPACE_DIR/.build/config" && -d "$WORKSPACE_DIR/.build/auto" ]] || return 0
    key=$(package_cache_key) || return 1
    safe_package_cache || return 1
    [[ ! -L "$WORKSPACE_DIR/.build/cache" ]] || return 1
    if has_mount_beneath "$WORKSPACE_DIR/.build/cache"; then mount_status=0; else mount_status=$?; fi
    (( mount_status == 1 )) || return 1
    for stage in bootstrap chroot binary; do
        if [[ -d "$WORKSPACE_DIR/.build/cache/packages.$stage" && ! -L "$WORKSPACE_DIR/.build/cache/packages.$stage" ]]; then
            if has_mount_beneath "$WORKSPACE_DIR/.build/cache/packages.$stage"; then mount_status=0; else mount_status=$?; fi
            (( mount_status == 1 )) || return 1
        fi
    done
    mkdir -p "$WORKSPACE_DIR/package-cache/$key" || return 1
    for stage in bootstrap chroot binary; do
        if [[ -d "$WORKSPACE_DIR/.build/cache/packages.$stage" && ! -L "$WORKSPACE_DIR/.build/cache/packages.$stage" ]]; then
            copy_package_debs "$WORKSPACE_DIR/.build/cache/packages.$stage" "$WORKSPACE_DIR/package-cache/$key/packages.$stage" || return 1
        fi
    done
}

update_current_output() {
    local current="$BUILD_JAHITAN_PATH/current" staged backup had_previous=0 mount_status

    if has_mount_beneath "$current"; then mount_status=0; else mount_status=$?; fi
    (( mount_status == 1 )) || {
        echo "Error: Mount beneath current Jahitan output" >&2
        return 1
    }

    staged=$(mktemp -d "$BUILD_JAHITAN_PATH/.current.stage.XXXXXXXX") || return 1
    if ! sudo cp -vR "$TARGET_DIR/." "$staged/" || \
       ! printf '%s\n' "$TODAY-$TODAY_COUNT" > "$staged/current.txt" || \
       ! sudo chmod --reference="$TARGET_DIR" "$staged"; then
        sudo rm -rf -- "$staged"
        return 1
    fi

    backup=$(mktemp -d "$BUILD_JAHITAN_PATH/.current.backup.XXXXXXXX") || {
        sudo rm -rf -- "$staged"
        return 1
    }
    if [[ -e "$current" || -L "$current" ]]; then
        if ! sudo mv -- "$current" "$backup/previous"; then
            sudo rm -rf -- "$staged" "$backup"
            return 1
        fi
        had_previous=1
    fi
    if ! sudo mv -- "$staged" "$current"; then
        if (( had_previous )) && ! sudo mv -- "$backup/previous" "$current"; then
            echo "Error: Previous current output remains at $backup/previous" >&2
        else
            sudo rm -rf -- "$backup"
        fi
        sudo rm -rf -- "$staged"
        return 1
    fi

    CURRENT_OUTPUT_UPDATED=1
    if ! sudo rm -rf -- "$backup"; then
        echo "Warning: Previous current output remains at $backup" >&2
    fi
}

publish_artifacts() {
    local suffix

    for suffix in contents files packages hybrid.iso; do
        if ! cp -v "$IMAGE_NAME.$suffix" "$TARGET_DIR/$IMAGE_NAME.$suffix"; then
            FAILURE_REASON="Error: Failed to publish $IMAGE_NAME.$suffix"
            RESULT="gagal terbit ❌"
            return 1
        fi
    done
    if ! zsyncmake -u "${BUILD_PUBLISH_URL}/current/$IMAGE_NAME.hybrid.iso" \
        -o "$TARGET_DIR/$IMAGE_NAME.hybrid.iso.zsync" "$TARGET_DIR/$IMAGE_NAME.hybrid.iso"; then
        FAILURE_REASON="Error: Failed to generate zsync metadata"
        RESULT="gagal terbit ❌"
        return 1
    fi
    if ! sha256sum "$TARGET_DIR/$IMAGE_NAME.hybrid.iso" | sed 's#  .*/#  #' > "$TARGET_DIR/$IMAGE_NAME.hybrid.iso.sha256sum"; then
        FAILURE_REASON="Error: Failed to generate SHA-256 checksum"
        RESULT="gagal terbit ❌"
        return 1
    fi
    if ! update_current_output; then
        FAILURE_REASON="Error: Failed to update current Jahitan artifacts"
        RESULT="gagal terbit ❌"
        return 1
    fi
}

finalize_build() {
    local end duration total_duration

    end=$(date +%s)
    duration=$((end - START))
    total_duration="Done in $(date -d@$duration -u +%H:%M:%S)."
    echo "$total_duration"
    if [[ -n "$IMAGE_NAME" && -f "$IMAGE_NAME.build.log" ]]; then
        [[ -z "$FAILURE_REASON" ]] || printf '%s\n' "$FAILURE_REASON" >> "$IMAGE_NAME.build.log"
        echo "$total_duration" >> "$IMAGE_NAME.build.log"
        if [[ -d "$TARGET_DIR" ]]; then
            tail -n 100 "$IMAGE_NAME.build.log" > "$TARGET_DIR/$IMAGE_NAME.tail100.build.log.txt"
            cp -v "$IMAGE_NAME.build.log" "$TARGET_DIR/$IMAGE_NAME.build.log.txt"
        fi
    fi

    sudo umount "$(mount | grep live-build | cut -d ' ' -f 3)" || true
}

handoff_output_ownership() {
    local status=0 output_root output_dir current_dir="" workspace_dir mount_targets mount_target generated_dir
    [[ "${HOST_UID:-}" =~ ^[0-9]+$ && "${HOST_GID:-}" =~ ^[0-9]+$ ]] || {
        echo "Error: HOST_UID and HOST_GID must be numeric IDs" >&2
        return 1
    }
    [[ -n "$TARGET_DIR" && -d "$TARGET_DIR" ]] || return 0
    output_root=$(realpath -- "$BUILD_JAHITAN_PATH") || return 1
    [[ "$output_root" != / ]] || {
        echo "Error: Refusing ownership handoff on filesystem root" >&2
        return 1
    }
    output_dir=$(realpath -- "$TARGET_DIR") || return 1
    [[ "$output_dir" == "$output_root/"* ]] || {
        echo "Error: Output target escapes BUILD_JAHITAN_PATH" >&2
        return 1
    }
    workspace_dir=$(realpath -- "$WORKSPACE_DIR") || return 1
    if [[ "$CURRENT_OUTPUT_UPDATED" == 1 && -d "$BUILD_JAHITAN_PATH/current" ]]; then
        current_dir=$(realpath -- "$BUILD_JAHITAN_PATH/current") || return 1
        [[ "$current_dir" == "$output_root/"* ]] || {
            echo "Error: Current output escapes BUILD_JAHITAN_PATH" >&2
            return 1
        }
    fi
    mount_targets=$(findmnt --raw --noheadings --output TARGET) || return 1
    while IFS= read -r mount_target; do
        printf -v mount_target '%b' "$mount_target"
        if [[ "$mount_target" == "$workspace_dir/"* || \
              "$mount_target" == "$output_dir" || "$mount_target" == "$output_dir/"* || \
              ( -n "$current_dir" && ( "$mount_target" == "$current_dir" || "$mount_target" == "$current_dir/"* ) ) ]]; then
            echo "Error: Mount beneath generated output; skipping ownership handoff: $mount_target" >&2
            return 1
        fi
    done <<< "$mount_targets"
    chown -- "$HOST_UID:$HOST_GID" "$output_root" || status=1
    chown -R -- "$HOST_UID:$HOST_GID" "$output_dir" || status=1
    chown -- "$HOST_UID:$HOST_GID" "$workspace_dir" || status=1
    for generated_dir in .build chroot local cache tmp package-cache; do
        [[ -d "$workspace_dir/$generated_dir" && ! -L "$workspace_dir/$generated_dir" ]] || continue
        chown -R -- "$HOST_UID:$HOST_GID" "$workspace_dir/$generated_dir" || status=1
    done
    if [[ -n "$current_dir" ]]; then
        chown -R -- "$HOST_UID:$HOST_GID" "$current_dir" || status=1
    fi
    return "$status"
}

usage() {
  echo "Usage: $0 --local <source-dir>"
  echo "       $0 --remote <repo> <branch> [commit]"
}

initialize_runtime_state() {
  trap cleanup EXIT
  RESULT="gagal terbit ❌"
  ACTION="Log build dapat disimak"
  FAILURE_REASON=""
  LOCAL_SOURCE=""
  REPO=""
  BRANCH=""
  COMMIT=""
  START=""
  LOCK_ACQUIRED=0
  CURRENT_OUTPUT_UPDATED=0
}

validate_host_root() {
  [[ "$BUILD_LOCAL" == /* ]] || {
    echo "Error: BUILD_LOCAL must be an absolute directory: $BUILD_LOCAL"
    exit 2
  }
  [[ -d "$BUILD_LOCAL" ]] || {
    echo "Error: BUILD_LOCAL directory not found: $BUILD_LOCAL"
    exit 2
  }
  if ! BUILD_LOCAL_ROOT=$(realpath -- "$BUILD_LOCAL"); then
    echo "Error: Cannot canonicalize BUILD_LOCAL: $BUILD_LOCAL"
    exit 2
  fi
  export BUILD_LOCAL="$BUILD_LOCAL_ROOT"
}

parse_local_source() {
  local source_candidate="$1"

  if [[ -z "$BUILDER_CONTAINER" ]]; then
    if [[ "$source_candidate" == /* ]]; then
      SOURCE_CANDIDATE=$source_candidate
    else
      SOURCE_CANDIDATE="$BUILD_LOCAL_ROOT/$source_candidate"
    fi
    [[ -d "$SOURCE_CANDIDATE" ]] || {
      echo "Error: Local source directory not found: $SOURCE_CANDIDATE"
      exit 2
    }
    if ! LOCAL_SOURCE=$(realpath -- "$SOURCE_CANDIDATE"); then
      echo "Error: Cannot canonicalize local source: $SOURCE_CANDIDATE"
      exit 2
    fi
    if [[ "$BUILD_LOCAL_ROOT" != "/" && "$LOCAL_SOURCE" != "$BUILD_LOCAL_ROOT" && "$LOCAL_SOURCE" != "$BUILD_LOCAL_ROOT/"* ]]; then
      echo "Error: Local source must stay under BUILD_LOCAL: $LOCAL_SOURCE"
      exit 2
    fi
  else
    [[ "$source_candidate" == /* ]] || { echo "Error: Local source path must be absolute: $source_candidate"; exit 2; }
    [[ -d "$source_candidate" ]] || { echo "Error: Local source directory not found: $source_candidate"; exit 2; }
    LOCAL_SOURCE=$source_candidate
  fi
}

parse_arguments() {
  MODE=$1
  if [[ -z "$BUILDER_CONTAINER" ]]; then
    validate_host_root
  fi
  case "$MODE" in
    --local)
      [[ $# -eq 2 ]] || { usage; exit 2; }
      parse_local_source "$2"
      ;;
    --remote)
      [[ $# -ge 3 && $# -le 4 ]] || { usage; exit 2; }
      REPO=$2
      BRANCH=$3
      COMMIT=${4:-}
      ;;
    *)
      usage
      exit 2
      ;;
  esac
}

run_in_container() {
  [[ -f "$SCRIPT_DIR/.env" ]] || {
    echo "Error: Environment file not found: $SCRIPT_DIR/.env"
    exit 1
  }
  command -v docker >/dev/null 2>&1 || {
    echo "Error: Docker is required but was not found in PATH."
    exit 1
  }
  docker compose version >/dev/null 2>&1 || {
    echo "Error: Docker Compose is required but is unavailable."
    exit 1
  }

  local host_uid host_gid
  host_uid=$(id -u) || return 1
  host_gid=$(id -g) || return 1
  exec {PACKAGE_CACHE_LOCK_FD}>"$SCRIPT_DIR/workdir/.package-cache.lock" || return 1
  flock -n "$PACKAGE_CACHE_LOCK_FD" || { echo "Error: Package cache is in use by another build or purge" >&2; return 1; }
  BUILD_LOCAL="$BUILD_LOCAL_ROOT" HOST_UID="$host_uid" HOST_GID="$host_gid" PACKAGE_CACHE_LOCK_HELD=1 docker compose \
    --project-directory "$SCRIPT_DIR" \
    --env-file "$SCRIPT_DIR/.env" \
    run --build --rm -e PACKAGE_CACHE_LOCK_HELD=1 builder /builder/build-iso "$@"
}

dispatch_build() {
  if [[ -z "$BUILDER_CONTAINER" ]]; then
    if [[ "$MODE" == "--local" ]]; then
      run_in_container --local "$LOCAL_SOURCE"
    else
      run_in_container "$@"
    fi
    return $?
  fi

  run_container_build
}

acquire_build_lock() {
  if [[ -f "$BUILD_LOCKFILE" ]]; then
    OLD_PID=$(cat "$BUILD_LOCKFILE")
    if ps -p "$OLD_PID" > /dev/null 2>&1; then
      echo "Error: Build already in progress (PID: $OLD_PID). Exiting."
      exit 1
    else
      echo "Warning: Removing stale lock file from PID $OLD_PID"
      rm -f "$BUILD_LOCKFILE"
    fi
  fi
  echo $$ > "$BUILD_LOCKFILE"
  LOCK_ACQUIRED=1
  START=$(date +%s)
}

prepare_output_directory() {
  if [[ "$BUILD_JAHITAN_PATH" != /* ]]; then
    FAILURE_REASON="Error: BUILD_JAHITAN_PATH must be an absolute path: $BUILD_JAHITAN_PATH"
    exit 1
  fi
  if ! mkdir -p "$BUILD_JAHITAN_PATH"; then
    FAILURE_REASON="Error: Cannot create BUILD_JAHITAN_PATH: $BUILD_JAHITAN_PATH"
    exit 1
  fi

  TODAY=$(date '+%Y%m%d')
  TODAY_COUNT=$(find "$BUILD_JAHITAN_PATH" -mindepth 1 -maxdepth 1 -type d -name "$TODAY-*" | wc -l)
  TODAY_COUNT=$((TODAY_COUNT + 1))
  TARGET_DIR="$BUILD_JAHITAN_PATH/$TODAY-$TODAY_COUNT"
  if ! mkdir -p "$TARGET_DIR"; then
    FAILURE_REASON="Error: Cannot create build output directory: $TARGET_DIR"
    exit 1
  fi
}

set_repository_name() {
  if [[ "$MODE" == "--local" ]]; then
    REPO_NAME="local:$LOCAL_SOURCE"
    BRANCH="local"
  else
    REPO_NAME=$(echo "$REPO" | sed -E 's|.*github.com[:/]([^/]+/[^/.]+)(\.git)?|\1|')
  fi
}

clean_build_workspace() {
  ARCH=amd64
  sudo umount "$(mount | grep live-build | cut -d ' ' -f 3)" || true
  sudo rm -rf ./chroot ./local ./cache ./tmp || true
}

build_local_image() {
  prepare_build_tree "$LOCAL_SOURCE" || exit 1
  local cache_key
  cd .build || exit 1
  sudo lb clean || exit 1
  cd .. || exit 1
  cache_key=$(package_cache_key) || exit 1
  restore_package_cache "$cache_key" || exit 1
  cd .build || exit 1
  sudo lb config --architectures "$ARCH" || exit 1
  if ! sudo lb build --debug | sudo tee -a "$IMAGE_NAME.build.log"; then
    FAILURE_REASON="Error: Local live-build failed"
    exit 1
  fi
}

prepare_remote_source() {
  echo "Processing $REPO $BRANCH $COMMIT ..."
  sudo mkdir -p tmp || true
  sudo chmod -R a+rw tmp

  if ! git clone -b "$BRANCH" "$REPO" "./tmp/$TODAY-$TODAY_COUNT" 2>&1; then
    FAILURE_REASON="Error: Failed to clone $REPO branch $BRANCH"
    exit 1
  fi
  if [[ ! -d "./tmp/$TODAY-$TODAY_COUNT/.git" ]]; then
    FAILURE_REASON="Error: Clone directory is missing or incomplete"
    exit 1
  fi
  if [[ -n "$COMMIT" ]] && ! git -C "./tmp/$TODAY-$TODAY_COUNT" checkout "$COMMIT"; then
    FAILURE_REASON="Error: Failed to checkout commit $COMMIT"
    exit 1
  fi

  COMMIT=$(git -C "./tmp/$TODAY-$TODAY_COUNT" rev-parse --short HEAD)
  CLEAN_REPO_URL=$(echo "$REPO" | sed 's/\.git$//')
  COMMIT_URL="$CLEAN_REPO_URL/commit/$COMMIT"
}

build_remote_image() {
  prepare_remote_source
  prepare_build_tree "./tmp/$TODAY-$TODAY_COUNT" || exit 1
  local cache_key
  cd .build || exit 1
  sudo sed -i 's/BUILD_NUMBER/'"$TODAY-$TODAY_COUNT"'/g' config/bootloaders/syslinux_common/splash.svg
  cd .. || exit 1
  cache_key=$(package_cache_key) || exit 1
  cd .build || exit 1
  sudo lb clean --purge || exit 1
  cd .. || exit 1
  restore_package_cache "$cache_key" || exit 1
  cd .build || exit 1
  sudo lb config --architectures "$ARCH" || exit 1
  sudo rm -f "$IMAGE_NAME.build.log"
  if ! sudo lb build 2>&1 | tee "$IMAGE_NAME.build.log"; then
    FAILURE_REASON="Error: Remote live-build failed"
    exit 1
  fi
}

build_image() {
  if [[ "$MODE" == "--local" ]]; then
    build_local_image
  else
    build_remote_image
  fi

  if ! tail -n 10 "$IMAGE_NAME.build.log" | grep -q "P: Build completed successfully"; then
    FAILURE_REASON="Error: Build did not complete successfully"
    exit 1
  fi

  RESULT="telah terbit ✅"
  ACTION="Berkas citra dapat diunduh"
  publish_artifacts || exit 1
}

run_container_build() {
  WORKSPACE_DIR=$(pwd -P) || exit 1
  if [[ "${PACKAGE_CACHE_LOCK_HELD:-}" != 1 ]]; then
    acquire_package_cache_lock || exit 1
  fi
  acquire_build_lock
  prepare_output_directory
  set_repository_name
  clean_build_workspace
  build_image
}

main() {
  validate_required_environment || exit 1
  initialize_runtime_state
  parse_arguments "$@"
  dispatch_build "$@"
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  [[ ! -f "$SCRIPT_DIR/.env" ]] || source "$SCRIPT_DIR/.env"
  main "$@"
  exit $?
fi
