#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)

if [[ -z "${BUILDER_CONTAINER:-}" ]]; then
  [[ "$#" -eq 0 ]] || { echo 'Usage: purge-iso' >&2; exit 2; }
  [[ -f "$SCRIPT_DIR/.env" ]] || { echo "Error: Environment file not found: $SCRIPT_DIR/.env" >&2; exit 1; }
  BUILD_LOCAL=
  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ "$line" =~ ^[[:space:]]*BUILD_LOCAL=(.*)$ ]] || continue
    [[ -z "$BUILD_LOCAL" ]] || { echo 'Error: Duplicate BUILD_LOCAL assignment in .env.' >&2; exit 1; }
    BUILD_LOCAL=${BASH_REMATCH[1]}
    if [[ "$BUILD_LOCAL" == \"* ]]; then [[ "$BUILD_LOCAL" == *\" ]] || exit 1; BUILD_LOCAL=${BUILD_LOCAL:1:${#BUILD_LOCAL}-2};
    elif [[ "$BUILD_LOCAL" == \'* ]]; then [[ "$BUILD_LOCAL" == *\' ]] || exit 1; BUILD_LOCAL=${BUILD_LOCAL:1:${#BUILD_LOCAL}-2}; fi
    [[ "$BUILD_LOCAL" =~ ^/[A-Za-z0-9_./[:space:]-]+$ ]] || { echo 'Error: Invalid BUILD_LOCAL assignment in .env.' >&2; exit 1; }
  done < "$SCRIPT_DIR/.env"
  [[ "$BUILD_LOCAL" == /* && -d "$BUILD_LOCAL" && ! -L "$BUILD_LOCAL" && "$BUILD_LOCAL" != / ]] || { echo 'Error: BUILD_LOCAL must be a safe absolute directory.' >&2; exit 1; }
  command -v podman >/dev/null 2>&1 || { echo 'Error: Podman is required.' >&2; exit 1; }
  [[ "$(env -u TELEGRAM_BOT_KEY -u TELEGRAM_BOT_KEY_FILE podman info --format '{{.Host.Security.Rootless}}')" == true ]] || { echo 'Error: A rootless Podman engine is required.' >&2; exit 1; }
  [[ ! -L "$SCRIPT_DIR/workdir" ]] || { echo 'Error: workdir cannot be a symlink.' >&2; exit 1; }
  mkdir -p -- "$SCRIPT_DIR/workdir"
  package_cache_lock="$SCRIPT_DIR/workdir/.package-cache.lock"
  [[ ! -L "$package_cache_lock" ]] || { echo 'Error: Package cache lock cannot be a symlink.' >&2; exit 1; }
  if [[ ! -e "$package_cache_lock" ]]; then ( set -o noclobber; : > "$package_cache_lock" ) 2>/dev/null || exit 1; fi
  [[ -f "$package_cache_lock" ]] || { echo 'Error: Package cache lock must be a regular file.' >&2; exit 1; }
  exec {LOCK_FD}>>"$package_cache_lock"
  flock -n "$LOCK_FD" || { echo 'Error: Package cache is in use by another build or purge.' >&2; exit 1; }
  env -u TELEGRAM_BOT_KEY -u TELEGRAM_BOT_KEY_FILE podman build --tag blankon-image-builder:podman --file "$SCRIPT_DIR/Dockerfile" "$SCRIPT_DIR"
  env -u TELEGRAM_BOT_KEY -u TELEGRAM_BOT_KEY_FILE podman run --rm --userns=host --user 0:0 --workdir /workdir \
    --volume "$SCRIPT_DIR/workdir:/workdir:rw" \
    --volume "$package_cache_lock:/workdir/.package-cache.lock:ro" \
    --env BUILDER_CONTAINER=1 --env PACKAGE_CACHE_LOCK_HELD=1 \
    blankon-image-builder:podman /usr/local/bin/purge-iso
  exit $?
fi

if [[ "${PACKAGE_CACHE_LOCK_HELD:-}" != 1 ]]; then
  [[ ! -L "$PWD/.package-cache.lock" ]] || { echo "Error: Package cache lock cannot be a symlink: $PWD/.package-cache.lock" >&2; exit 1; }
  if [[ ! -e "$PWD/.package-cache.lock" ]]; then
    ( set -o noclobber; : > "$PWD/.package-cache.lock" ) 2>/dev/null || { echo "Error: Cannot safely create package cache lock: $PWD/.package-cache.lock" >&2; exit 1; }
  fi
  [[ -f "$PWD/.package-cache.lock" && ! -L "$PWD/.package-cache.lock" ]] || { echo "Error: Package cache lock must be a regular file: $PWD/.package-cache.lock" >&2; exit 1; }
  exec {LOCK_FD}>>"$PWD/.package-cache.lock"
  flock -n "$LOCK_FD" || { echo "Error: Package cache is in use by another build or purge" >&2; exit 1; }
fi
cache="$PWD/package-cache"
[[ ! -L "$cache" && ( ! -e "$cache" || -d "$cache" ) ]] || { echo "Error: Unsafe package-cache path: $cache" >&2; exit 1; }
if [[ -e "$cache" ]]; then
  real_cache=$(realpath -- "$cache")
  [[ "$real_cache" == "$PWD/package-cache" && "$real_cache" != / ]] || { echo "Error: Unsafe package-cache location" >&2; exit 1; }
  paths=$(find -P "$cache" -mindepth 1 -print) || { echo "Error: Cannot inspect package cache" >&2; exit 1; }
  mounts=$(findmnt --raw --noheadings --output TARGET) || { echo "Error: Cannot inspect mounts" >&2; exit 1; }
  while IFS= read -r path; do
    [[ ! -L "$path" ]] || { echo "Error: Symlink in package cache: $path" >&2; exit 1; }
  done <<< "$paths"
  while IFS= read -r target; do
    printf -v target '%b' "$target"
    [[ "$target" != "$real_cache" && "$target" != "$real_cache/"* ]] || { echo "Error: Mount beneath package cache: $target" >&2; exit 1; }
  done <<< "$mounts"
  rm -rf -- "$real_cache"
fi
