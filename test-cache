#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
source "$SCRIPT_DIR/build-iso"
tmp=$(mktemp -d)
trap 'rm -rf -- "$tmp"' EXIT
WORKSPACE_DIR=$tmp
ARCH=amd64
mkdir -p "$tmp/.build/config/includes.chroot/etc/blankon" "$tmp/.build/auto" "$tmp/.build/cache/packages.bootstrap" "$tmp/.build/cache/bootstrap"
mkdir -p "$tmp/bin"
printf '#!/usr/bin/env bash\nexit 1\n' > "$tmp/bin/findmnt"
chmod +x "$tmp/bin/findmnt"
printf 'ARCHIVE_HOST=deb.example\nSUITE=stable\nURI=main\n' > "$tmp/.build/config/includes.chroot/etc/blankon/archive.conf"
key=$(package_cache_key)
mkdir -p "$tmp/.build/config/variant-extra"
printf 'variant package selection\n' > "$tmp/.build/config/variant-extra/packages"
[[ "$key" == "$(package_cache_key)" ]]
printf changed > "$tmp/.build/config/includes.chroot/etc/blankon/archive.conf"
[[ "$key" != "$(package_cache_key)" ]]
printf 'ARCHIVE_HOST=deb.example\nSUITE=stable\nURI=main\n' > "$tmp/.build/config/includes.chroot/etc/blankon/archive.conf"
key=$(package_cache_key)
printf deb > "$tmp/.build/cache/packages.bootstrap/pkg.deb"
printf metadata > "$tmp/.build/cache/packages.bootstrap/Packages.gz"
printf stage > "$tmp/.build/cache/bootstrap/state"
PATH="$tmp/bin:$PATH"
if save_package_cache >/dev/null 2>&1; then exit 1; fi
if restore_package_cache "$key" >/dev/null 2>&1; then exit 1; fi
[[ ! -e "$tmp/package-cache" && -e "$tmp/.build/cache/packages.bootstrap/pkg.deb" ]]
printf '#!/usr/bin/env bash\nprintf "%%s\\n" "$MOUNT_TARGET"\n' > "$tmp/bin/findmnt"
chmod +x "$tmp/bin/findmnt"
if MOUNT_TARGET="$tmp/.build/cache" save_package_cache >/dev/null 2>&1; then exit 1; fi
[[ ! -e "$tmp/package-cache" ]]
printf '#!/usr/bin/env bash\nexit 0\n' > "$tmp/bin/findmnt"
chmod +x "$tmp/bin/findmnt"
save_package_cache
[[ -f "$tmp/package-cache/$key/packages.bootstrap/pkg.deb" && ! -e "$tmp/package-cache/$key/packages.bootstrap/Packages.gz" ]]
rm -rf "$tmp/.build/cache"
mkdir -p "$tmp/.build/cache"
restore_package_cache "$key"
[[ -f "$tmp/.build/cache/packages.bootstrap/pkg.deb" && ! -e "$tmp/.build/cache/packages.bootstrap/Packages.gz" && ! -e "$tmp/.build/cache/bootstrap" ]]
exec {lock_fd}>"$tmp/.package-cache.lock"
flock -n "$lock_fd"
if (exec {other_fd}>"$tmp/.package-cache.lock"; flock -n "$other_fd") 2>/dev/null; then exit 1; fi
mkdir -p "$tmp/package-cache"
ln -s /tmp "$tmp/package-cache/unsafe"
if safe_package_cache; then exit 1; fi
rm -rf "$tmp/package-cache"
mkdir -p "$tmp/package-cache/$key"
printf preserved > "$tmp/package-cache/$key/sentinel"
if (cd "$tmp" && BUILDER_CONTAINER=1 PATH="$tmp/bin:$PATH" "$SCRIPT_DIR/purge-iso") 2>/dev/null; then exit 1; fi
[[ -f "$tmp/package-cache/$key/sentinel" ]]
purge_tmp="$tmp/purge-test"
mkdir -p "$purge_tmp/package-cache/$key" "$purge_tmp/.build" "$purge_tmp/output" "$purge_tmp/bin"
printf package > "$purge_tmp/package-cache/$key/pkg.deb"
printf build > "$purge_tmp/.build/keep"
printf output > "$purge_tmp/output/keep"
printf '#!/usr/bin/env bash\nexit 0\n' > "$purge_tmp/bin/findmnt"
chmod +x "$purge_tmp/bin/findmnt"
(cd "$purge_tmp" && BUILDER_CONTAINER=1 PATH="$purge_tmp/bin:$PATH" "$SCRIPT_DIR/purge-iso")
[[ ! -e "$purge_tmp/package-cache" && -f "$purge_tmp/.build/keep" && -f "$purge_tmp/output/keep" ]]
mkdir -p "$purge_tmp/package-cache/$key"
printf package > "$purge_tmp/package-cache/$key/pkg.deb"
printf '#!/usr/bin/env bash\nprintf "%%s\\n" "$MOUNT_TARGET"\n' > "$purge_tmp/bin/findmnt"
chmod +x "$purge_tmp/bin/findmnt"
if (cd "$purge_tmp" && MOUNT_TARGET="$purge_tmp/package-cache/$key/nested" BUILDER_CONTAINER=1 PATH="$purge_tmp/bin:$PATH" "$SCRIPT_DIR/purge-iso") 2>/dev/null; then exit 1; fi
[[ -f "$purge_tmp/package-cache/$key/pkg.deb" ]]
printf '#!/usr/bin/env bash\nexit 0\n' > "$purge_tmp/bin/findmnt"
exec {purge_lock_fd}>"$purge_tmp/.package-cache.lock"
flock -n "$purge_lock_fd"
if (cd "$purge_tmp" && BUILDER_CONTAINER=1 PATH="$purge_tmp/bin:$PATH" "$SCRIPT_DIR/purge-iso") 2>/dev/null; then exit 1; fi
[[ -f "$purge_tmp/package-cache/$key/pkg.deb" ]]
printf 'cache key, restore, lock, symlink self-check passed\n'
