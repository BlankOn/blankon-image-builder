#!/usr/bin/env bash
set -euo pipefail

script_dir=$(cd -- "$(dirname -- "$0")" && pwd)
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
mkdir -p "$tmp/run" "$tmp/current" "$tmp/workspace" "$tmp/bin"
: > "$tmp/calls"
cat > "$tmp/bin/chown" <<'EOF'
#!/usr/bin/env bash
printf '%s\n' "$*" >> "$CHOWN_CALLS"
[[ "${CHOWN_FAIL:-}" != "${*: -1}" ]]
EOF
chmod +x "$tmp/bin/chown"
cat > "$tmp/bin/findmnt" <<'EOF'
#!/usr/bin/env bash
[[ "${FINDMNT_FAIL:-}" != 1 ]] || exit 1
printf '%s\n' "${MOUNT_TARGETS:-/}"
EOF
chmod +x "$tmp/bin/findmnt"
source <(sed -n '/^handoff_output_ownership() {/,/^}/p' "$script_dir/build-iso")

TARGET_DIR="$tmp/run"
WORKSPACE_DIR="$tmp/workspace"
BUILD_JAHITAN_PATH="$tmp"
CURRENT_OUTPUT_UPDATED=0
HOST_UID=123 HOST_GID=456 CHOWN_CALLS="$tmp/calls" PATH="$tmp/bin:$PATH" handoff_output_ownership
[[ $(wc -l < "$tmp/calls") -eq 3 ]]
[[ $(<"$tmp/calls") == $'-- 123:456 '"$tmp"$'\n-R -- 123:456 '"$tmp/run"$'\n-- 123:456 '"$tmp/workspace" ]]

: > "$tmp/calls"
mkdir -p "$tmp/workspace/.build"
HOST_UID=123 HOST_GID=456 TARGET_DIR="$tmp/run" WORKSPACE_DIR="$tmp/workspace" \
    BUILD_JAHITAN_PATH="$tmp" CHOWN_CALLS="$tmp/calls" PATH="$tmp/bin:$PATH" \
    MOUNT_TARGETS="$tmp/workspace" handoff_output_ownership
[[ $(wc -l < "$tmp/calls") -eq 4 ]]
[[ $(<"$tmp/calls") == $'-- 123:456 '\
"$(realpath "$tmp")"$'\n-R -- 123:456 '\
"$(realpath "$tmp/run")"$'\n-- 123:456 '\
"$(realpath "$tmp/workspace")"$'\n-R -- 123:456 '\
"$(realpath "$tmp/workspace/.build")" ]]
rmdir "$tmp/workspace/.build"

mkdir -p "$tmp/workspace/.build/mounted dir"
: > "$tmp/calls"
escaped_mount="$tmp/workspace/.build/mounted\\040dir"
if HOST_UID=123 HOST_GID=456 TARGET_DIR="$tmp/run" WORKSPACE_DIR="$tmp/workspace" \
    BUILD_JAHITAN_PATH="$tmp" CHOWN_CALLS="$tmp/calls" PATH="$tmp/bin:$PATH" \
    MOUNT_TARGETS="$escaped_mount" handoff_output_ownership 2>/dev/null; then
    exit 1
fi
[[ ! -s "$tmp/calls" ]]
rmdir "$tmp/workspace/.build/mounted dir" "$tmp/workspace/.build"

: > "$tmp/calls"
CURRENT_OUTPUT_UPDATED=1
HOST_UID=123 HOST_GID=456 CHOWN_CALLS="$tmp/calls" PATH="$tmp/bin:$PATH" handoff_output_ownership
[[ $(wc -l < "$tmp/calls") -eq 4 ]]

: > "$tmp/calls"
if HOST_UID=123 HOST_GID=456 CURRENT_OUTPUT_UPDATED=0 TARGET_DIR="$tmp/run" \
    BUILD_JAHITAN_PATH="$tmp" CHOWN_CALLS="$tmp/calls" PATH="$tmp/bin:$PATH" \
    MOUNT_TARGETS="$tmp/run/mounted" handoff_output_ownership 2>/dev/null; then
    exit 1
fi
[[ ! -s "$tmp/calls" ]]

: > "$tmp/calls"
if HOST_UID=123 HOST_GID=456 TARGET_DIR="$tmp/run" WORKSPACE_DIR="$tmp/workspace" \
    BUILD_JAHITAN_PATH="$tmp" CHOWN_CALLS="$tmp/calls" PATH="$tmp/bin:$PATH" \
    MOUNT_TARGETS="$tmp/workspace/.build" handoff_output_ownership 2>/dev/null; then
    exit 1
fi
[[ ! -s "$tmp/calls" ]]

if HOST_UID=123 HOST_GID=456 TARGET_DIR="$tmp/run" BUILD_JAHITAN_PATH="$tmp" \
    PATH="$tmp/bin:$PATH" FINDMNT_FAIL=1 handoff_output_ownership 2>/dev/null; then
    exit 1
fi
[[ ! -s "$tmp/calls" ]]

if HOST_UID='1;false' HOST_GID=456 handoff_output_ownership 2>/dev/null; then
    exit 1
fi

: > "$tmp/calls"
if HOST_UID=123 HOST_GID=456 CURRENT_OUTPUT_UPDATED=1 TARGET_DIR="$tmp/run" \
    BUILD_JAHITAN_PATH="$tmp" CHOWN_CALLS="$tmp/calls" PATH="$tmp/bin:$PATH" \
    CHOWN_FAIL="$tmp/run" handoff_output_ownership; then
    exit 1
fi
[[ $(wc -l < "$tmp/calls") -eq 4 ]]
